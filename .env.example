# SQLite database file. In Docker this lives inside the mounted volume.
DATABASE_PATH=./data/mtg.db

# Daily Scryfall price refresh, run inside the app process.
# Defaults: enabled in production, disabled in development.
CRON_ENABLED=true

# Standard five-field cron expression. Scryfall rebuilds its bulk data once a
# day at around 09:00 UTC; this leaves an hour of slack.
CRON_SCHEDULE=15 10 * * *
CRON_TIMEZONE=UTC

# Port the container publishes on the host.
PORT=3000
