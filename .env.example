# SQLite database file. In Docker this lives inside the mounted volume.
DATABASE_PATH=./data/mtg.db

# Host directory holding the database, bind-mounted into the container.
# Defaults to ./data next to the compose file. Set it when the database lives
# elsewhere — e.g. DATA_DIR=/srv/mtg/data — so you never have to edit
# docker-compose.yml and resolve a conflict on the next `git pull`.
# DATA_DIR=./data

# The daily refresh: Scryfall metadata, then MTGJSON prices.
# Defaults: enabled in production, disabled in development.
CRON_ENABLED=true

# Standard five-field cron expression, read in CRON_TIMEZONE. 10:00 UTC is
# overnight across the Americas and sits just under an hour after Scryfall's
# ~09:05 UTC build. UTC rather than a local zone, so that gap stays fixed
# instead of moving with daylight saving. A named zone such as
# America/Chicago works if you would rather pin the local hour.
#
# Set this to "* * * * *" temporarily to prove a new deployment's schedule
# actually fires, then put it back.
CRON_SCHEDULE=0 10 * * *
CRON_TIMEZONE=UTC

# How the price ingest is launched. It runs as a child process rather than
# inside the web server, which is why it names a runtime rather than being a
# flag. The image sets a working default; leave this unset unless you are
# changing it. Set it EMPTY to skip prices in the container and run
# `ingest:today` from outside instead — that reads as "not run" rather than as
# a failure, so it will not light up the dashboard as broken.
# INGEST_COMMAND=node_modules/.bin/tsx scripts/ingest-today.mts --rebuild-cache

# Kills a wedged ingest rather than letting it hold the write lock until the
# next day's run collides with it. Default 30 minutes.
# INGEST_TIMEOUT_MS=1800000

# How a stale portfolio cache is rebuilt. Anything that changes holdings or
# prices leaves the cached value history behind; rather than recomputing inside
# the request that noticed — 20-35 seconds, and every concurrent request starts
# its own — the page is served from the existing cache, marked "updating", and
# a rebuild runs in the background. The image sets a working default.
# Set it EMPTY to disable, which leaves reads serving stale figures until
# something rebuilds explicitly.
# REBUILD_COMMAND=npm run cache:portfolio

# Port the container publishes on the host.
PORT=3000

# --- Uploaded collections, and who may write to the host's own ------------

# Allows /import, which REPLACES the host's collection: quantities are set
# from the file and cards it does not mention are deleted. There is no login
# here, so this is default-closed — on a public instance it would be a
# stranger's button for overwriting somebody else's cards. Set it on a
# self-hosted instance; leave it unset on a public one. The CLI importer
# (npm run import:moxfield) is unaffected either way.
# ENABLE_OWNER_IMPORT=true

# Hides every value on screen until this password is typed, for an instance
# other people can see the screen of. Unset — the right default for a public
# instance — values simply show and the toggle is an ordinary hide button.
# The password reaches the browser in order to be checked there, and the
# figures are in the HTML regardless: this covers a screen, it is not access
# control.
# PRIVACY_PASSWORD=

# How long an uploaded collection survives without being looked at, and how
# many are kept at once. Every page view touches its session, so the TTL is
# idle time rather than age.
# SESSION_TTL_HOURS=48
# SESSION_LIMIT=200

# Keeps the session cookie usable over plain HTTP. A LAN instance reached at
# http://host:3010 has no certificate, and a `secure` cookie would be dropped
# on every request. Leave unset behind TLS.
# ALLOW_INSECURE_COOKIE=true
